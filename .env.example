# ===========================================
# PDF-to-LaTeX Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Hugging Face API (Required for VLM-based OCR)
HF_TOKEN=token here 


# Model Configuration
HF_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
HF_USE_INFERENCE_API=true

# API Settings
API_KEY=your_api_key_for_production
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
RATE_LIMIT_PER_MINUTE=30
MAX_FILE_SIZE_MB=50

# Redis Configuration
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage Paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Logging
LOG_LEVEL=INFO

# LaTeX Settings
DEFAULT_DOCUMENT_CLASS=article
DPI=200
